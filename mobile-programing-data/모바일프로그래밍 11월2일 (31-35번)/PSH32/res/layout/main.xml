<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

    <!-- 제목 TextView: id 필요 없음 -->
    <TextView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="박상훈#32-버튼사용법2" />

    <!-- 입력(Input): EditText -->
    <EditText
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:id="@+id/a_edt" />

    <!-- 처리(Process): Button -->
    <Button
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="확인"
        android:textSize="15pt"
        android:id="@+id/b_btn" />

    <!-- 출력(Output): 결과 TextView, 맨 마지막이라 height도 fill_parent -->
    <TextView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:textSize="12pt"
        android:id="@+id/c_txt" />

</LinearLayout>
